<.title :if={false}>
  <%= @kveg.firstname %> <%= @kveg.lastname %>

  <:side>
    <div class="border border-teal-500 rounded-md py-2 bg-teal-100 text-teal-500 flex flex-row justify-between items-center px-4">
      <.icon name="hero-check-circle-solid" class="mr-2" />
      <div class="font-semibold">
        Sauna pass valid
      </div>
    </div>
  </:side>
</.title>

<section class="flex flex-col sm:flex-row justify-between items-stretch gap-6">
  <.balance_card balance={@kveg.balance - 200} />
  <.sauna_card pass_end={@kveg.sauna_pass_end} />
</section>

<section class="flex flex-col sm:flex-row justify-stretch items-stretch gap-6 my-10">
  <.action to={~p"/kveg/shop"} class="w-full">
    Rent things at Låven
  </.action>

  <.action to={~p"/kveg/shop"} class="w-full">
    Buy things at Dypet
  </.action>
</section>

<.split>Upcoming trips</.split>

<section class="flex flex-row gap-4 justify-end my-4"></section>

<.split class="mt-24">Or</.split>

<ul class="grid grid-cols-1 sm:grid-cols-2 grid-flow-row gap-x-12 w-5/6 mx-auto text-lg text-blue-800 hover:cursor-pointer underline underline-offset-4">
  <li>View your purchasing history</li>
  <li>Change your account details</li>
  <li>Play a game of Rose</li>
  <li>See Dypet statistics</li>
</ul>
