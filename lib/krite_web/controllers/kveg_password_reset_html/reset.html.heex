<section class="w-2/3 mx-auto">
  <h1 class="text-2xl text-nat-700 pb-3 font-semibold">Set a new password</h1>

  <.stop_message message={@stop_message} />

  <.form
    :let={f}
    :if={!@stop_message}
    as={:kveg}
    for={@changeset}
    action={~p"/reset-password/#{@handle}"}
  >
    <.input field={f[:password]} type="password" label="Password" required />

    <.input field={f[:password_confirmation]} type="password" label="Repeat password" required />

    <.button class="mt-6 w-full">
      Set new password
    </.button>
  </.form>

  <.back_to_login :if={@stop_message} />
</section>
